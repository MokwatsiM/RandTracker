# The part of Supabase's API gateway this app needs: routes /auth/v1 and /rest/v1,
# requires an API key on them, and allows browser requests from the site only.
# The keys are long JWTs, which don't fit the default bucket.
map_hash_bucket_size 256;

map $http_apikey $api_key_ok {
    default 0;
    "${ANON_KEY}" 1;
    "${SERVICE_ROLE_KEY}" 1;
}

map $http_origin $cors_origin {
    default "";
    "${SITE_URL}" $http_origin;
}

server {
    listen 8000;
    client_max_body_size 5m;

    # Queries carry financial filters, so they don't belong in logs.
    access_log off;

    # Look services up per request so restarting one doesn't break the gateway.
    resolver 127.0.0.11 valid=10s;
    set $auth_upstream auth:9999;
    set $rest_upstream rest:3000;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Expose-Headers;
    proxy_hide_header Vary;

    add_header Vary Origin always;
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Credentials true always;
    add_header Access-Control-Allow-Methods "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers $http_access_control_request_headers always;
    add_header Access-Control-Expose-Headers "Content-Range, Range, X-Total-Count, X-Supabase-Api-Version" always;
    add_header Access-Control-Max-Age 3600 always;

    if ($request_method = OPTIONS) {
        return 204;
    }

    location = /health {
        access_log off;
        return 200 "ok\n";
    }

    # Reached by browser redirects from email links and OAuth, so they carry no API key.
    location ~ ^/auth/v1/(verify|callback|authorize)$ {
        rewrite ^/auth/v1/(.*)$ /$1 break;
        proxy_pass http://$auth_upstream;
    }

    location /auth/v1/ {
        if ($api_key_ok = 0) {
            return 401 '{"message":"Invalid API key"}';
        }
        rewrite ^/auth/v1/(.*)$ /$1 break;
        proxy_pass http://$auth_upstream;
    }

    location /rest/v1/ {
        if ($api_key_ok = 0) {
            return 401 '{"message":"Invalid API key"}';
        }
        rewrite ^/rest/v1/(.*)$ /$1 break;
        proxy_pass http://$rest_upstream;
    }

    location / {
        return 404 '{"message":"Not found"}';
    }
}
